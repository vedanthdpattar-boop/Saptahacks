AI_PROVIDER=<workers-ai-or-gemini>
AI_MODEL=<supported-json-mode-model-id>
FRONTEND_ORIGIN=<comma-separated-exact-localhost-and-production-origins>
CROSSREF_CONTACT_EMAIL=<your-team-contact-email>
